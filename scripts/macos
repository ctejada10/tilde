#!/usr/bin/env bash

# ~/.macos — https://mths.be/macos

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --check reports what would change without writing anything.
if [ "${1:-}" = "--check" ] || [ "${1:-}" = "-n" ]; then
  export DEFAULTS_CHECK=1
fi

# shellcheck source=scripts/lib/defaults.sh
. "$SCRIPT_DIR/lib/defaults.sh"

# Ask for the administrator password upfront (not needed for a dry run)
if [ "${DEFAULTS_CHECK:-0}" != "1" ]; then
  sudo -v
  # Keep-alive: refresh the sudo timestamp until this script has finished
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

# Step 1: Update the OS and Install Xcode Tools
echo "------------------------------"
#echo "Updating OSX.  If this requires a restart, run the script again."
# Install all available updates
#sudo softwareupdate -ia --verbose
# Install only recommended available updates
#sudo softwareupdate -ir --verbose

echo "------------------------------"

if [ "${DEFAULTS_CHECK:-0}" = "1" ]; then
  echo "  would run  Homebrew install + brew bundle + oh-my-zsh install"
else
  source "$SCRIPT_DIR/.brew"
  # Install oh-my-zsh without modifying .zshrc (stow manages that)
  RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
    sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"

  # KEEP_ZSHRC only protects an *existing* .zshrc. On a fresh machine there is
  # none, so the installer drops its own template in place — which would then
  # make `stow zsh` fail with a conflict in phase 2. Remove the template.
  if [ -f "$HOME/.zshrc" ] && [ ! -L "$HOME/.zshrc" ] \
     && grep -q "oh-my-zsh.sh" "$HOME/.zshrc" \
     && ! grep -q "MNML_PROMPT" "$HOME/.zshrc"; then
    echo "Removing the oh-my-zsh template ~/.zshrc so stow can link ours."
    rm -f "$HOME/.zshrc"
  fi
fi

###############################################################################
# OS Settings                                                                 #
###############################################################################

# Close any open System Preferences panes, to prevent them from overriding
# settings we’re about to change
run osascript -e 'tell application "System Preferences" to quit'

if [ "${DEFAULTS_CHECK:-0}" != "1" ]; then
  sudo -v
  while true; do sudo -n true; sleep 60; kill -0 "$$" || exit; done 2>/dev/null &
fi

###############################################################################
# General UI/UX                                                               #
###############################################################################

# Set computer name (as done via System Preferences → Sharing)
run sudo scutil --set HostName "arnor"

# Disable the sound effects on boot
# sudo nvram SystemAudioVolume=" "

# Set highlight color to my blue
defaults_set NSGlobalDomain AppleHighlightColor string "0.1725490196 0.2862745098 0.4980392157"

# Set sidebar icon size to small
defaults_set NSGlobalDomain NSTableViewDefaultSizeMode int 1

# Scrollbars only when scrolling
defaults_set NSGlobalDomain AppleShowScrollBars string "WhenScrolling"
# Possible values: `WhenScrolling`, `Automatic` and `Always`

# Save to disk (not to iCloud) by default
# defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false

# Automatically quit printer app once the print jobs complete
defaults_set com.apple.print.PrintingPrefs "Quit When Finished" bool true

# Disable the “Are you sure you want to open this application?” dialog
defaults_set com.apple.LaunchServices LSQuarantine bool false

# Remove duplicates in the “Open With” menu (also see `lscleanup` alias)
run /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user

# Disable Resume system-wide
defaults_set com.apple.systempreferences NSQuitAlwaysKeepsWindows bool false

# Disable automatic capitalization as it’s annoying when typing code
defaults_set NSGlobalDomain NSAutomaticCapitalizationEnabled bool false

# Disable automatic period substitution as it’s annoying when typing code
defaults_set NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled bool false

# Disable smart quotes as they’re annoying when typing code
defaults_set NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled bool false

# Tighten menu bar status item spacing
defaults_set_host -globalDomain NSStatusItemSpacing int 6

###############################################################################
# Trackpad, mouse, keyboard, Bluetooth accessories, and input                 #
###############################################################################

# Use “natural” (Lion-style) scrolling
defaults_set NSGlobalDomain com.apple.swipescrolldirection bool true

# Increase sound quality for Bluetooth headphones/headsets
defaults_set com.apple.BluetoothAudioAgent "Apple Bitpool Min (editable)" int 40

# Enable full keyboard access for all controls
# (e.g. enable Tab in modal dialogs)
# defaults write NSGlobalDomain AppleKeyboardUIMode -int 3

# Use scroll gesture with the Ctrl (^) modifier key to zoom
#defaults write com.apple.universalaccess closeViewScrollWheelToggle -bool true
#defaults write com.apple.universalaccess HIDScrollZoomModifierMask -int 262144
# Follow the keyboard focus while zoomed in
# defaults write com.apple.universalaccess closeViewZoomFollowsFocus -bool true

# Disable press-and-hold for keys in favor of key repeat
defaults_set NSGlobalDomain ApplePressAndHoldEnabled bool false

# Set the timezone; see `sudo systemsetup -listtimezones` for other values
run sudo systemsetup -settimezone "Europe/Copenhagen" > /dev/null

# Stop iTunes from responding to the keyboard media keys
# launchctl unload -w /System/Library/LaunchAgents/com.apple.rcd.plist 2> /dev/null

###############################################################################
# Energy saving                                                               #
###############################################################################

# Enable lid wakeup
run sudo pmset -a lidwake 1

# Restart automatically on power loss
run sudo pmset -a autorestart 1

# Restart automatically if the computer freezes
run sudo systemsetup -setrestartfreeze on

# Sleep the display after 15 minutes
run sudo pmset -a displaysleep 15

# Disable machine sleep while charging
run sudo pmset -c sleep 0

# Set machine sleep to 5 minutes on battery
run sudo pmset -b sleep 5

# Set standby delay to 24 hours (default is 1 hour)
run sudo pmset -a standbydelay 86400

# Never go into computer sleep mode
run sudo systemsetup -setcomputersleep Off > /dev/null

# Hibernation mode
# 0: Disable hibernation (speeds up entering sleep mode)
# 3: Copy RAM to disk so the system state can still be restored in case of a
#    power failure.
run sudo pmset -a hibernatemode 0

# Remove the sleep image file to save disk space
run sudo rm /private/var/vm/sleepimage
# Create a zero-byte file instead…
run sudo touch /private/var/vm/sleepimage
# …and make sure it can’t be rewritten
run sudo chflags uchg /private/var/vm/sleepimage

###############################################################################
# Screen                                                                      #
###############################################################################

# Require password immediately after sleep or screen saver begins
defaults_set com.apple.screensaver askForPassword int 1
defaults_set com.apple.screensaver askForPasswordDelay int 0

# Save screenshots to iCloud Drive. macOS silently ignores this if the folder
# does not exist, and iCloud Drive only appears once you have signed in — so
# only set it when iCloud Drive is actually there.
SCREENSHOT_DIR="$HOME/Library/Mobile Documents/com~apple~CloudDocs/Temporary Files/media/screenshots"
if [ -d "$HOME/Library/Mobile Documents/com~apple~CloudDocs" ]; then
	mkdir -p "$SCREENSHOT_DIR"
	defaults write com.apple.screencapture location -string "$SCREENSHOT_DIR"
else
	echo "iCloud Drive not set up yet — skipping screenshot location."
	echo "After signing into iCloud, run:"
	echo "  mkdir -p \"$SCREENSHOT_DIR\" && defaults write com.apple.screencapture location -string \"$SCREENSHOT_DIR\" && killall SystemUIServer"
fi

# Save screenshots in PNG format (other options: BMP, GIF, JPG, PDF, TIFF)
defaults_set com.apple.screencapture type string "png"

# Disable shadow in screenshots
defaults_set com.apple.screencapture disable-shadow bool true

# Enable subpixel font rendering on non-Apple LCDs
# Reference: https://github.com/kevinSuttle/macOS-Defaults/issues/17#issuecomment-266633501
defaults_set NSGlobalDomain AppleFontSmoothing int 1

# Enable HiDPI display modes (requires restart)
defaults_set_sudo /Library/Preferences/com.apple.windowserver DisplayResolutionEnabled bool true

###############################################################################
# Finder                                                                      #
###############################################################################

# Set Home as the default location for new Finder windows
# PfHm = Home, PfDe = Desktop. For other paths use `PfLo` with a file:// path.
defaults_set com.apple.finder NewWindowTarget string "PfHm"
defaults_set com.apple.finder NewWindowTargetPath string "file://${HOME}/"

# Finder: show all filename extensions
# defaults write NSGlobalDomain AppleShowAllExtensions -bool true

# Finder: show status bar
# defaults write com.apple.finder ShowStatusBar -bool true

# Keep folders on top when sorting by name
defaults_set com.apple.finder _FXSortFoldersFirst bool true

# When performing a search, search the current folder by default
defaults_set com.apple.finder FXDefaultSearchScope string "SCcf"

# Disable the warning when changing a file extension
defaults_set com.apple.finder FXEnableExtensionChangeWarning bool false

# Avoid creating .DS_Store files on network or USB volumes
defaults_set com.apple.desktopservices DSDontWriteNetworkStores bool true
defaults_set com.apple.desktopservices DSDontWriteUSBStores bool true

# Disable disk image verification
defaults_set com.apple.frameworks.diskimages skip-verify bool true
defaults_set com.apple.frameworks.diskimages skip-verify-locked bool true
defaults_set com.apple.frameworks.diskimages skip-verify-remote bool true

# Show item info near icons on the desktop and in other icon views
run /usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:showItemInfo true" ~/Library/Preferences/com.apple.finder.plist

# Show item info to the bottom of the icons on the desktop
run /usr/libexec/PlistBuddy -c "Set DesktopViewSettings:IconViewSettings:labelOnBottom true" ~/Library/Preferences/com.apple.finder.plist

# Enable snap-to-grid for icons on the desktop and in other icon views
run /usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:arrangeBy grid" ~/Library/Preferences/com.apple.finder.plist

# Increase grid spacing for icons on the desktop and in other icon views
run /usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:gridSpacing 100" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:gridSpacing 100" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:gridSpacing 100" ~/Library/Preferences/com.apple.finder.plist

# Increase the size of icons on the desktop and in other icon views
run /usr/libexec/PlistBuddy -c "Set :DesktopViewSettings:IconViewSettings:iconSize 80" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :FK_StandardViewSettings:IconViewSettings:iconSize 80" ~/Library/Preferences/com.apple.finder.plist
run /usr/libexec/PlistBuddy -c "Set :StandardViewSettings:IconViewSettings:iconSize 80" ~/Library/Preferences/com.apple.finder.plist

# Disable the warning before emptying the Trash
defaults_set com.apple.finder WarnOnEmptyTrash bool false

###############################################################################
# Dock, Dashboard, and hot corners                                            #
###############################################################################

# Set the icon size of Dock items to 36 pixels
defaults_set com.apple.dock tilesize int 36

# Minimize windows into their application’s icon
defaults_set com.apple.dock minimize-to-application bool true

# Show indicator lights for open applications in the Dock
defaults_set com.apple.dock show-process-indicators bool true

# Disable Dashboard
defaults_set com.apple.dashboard mcx-disabled bool true

# Don’t show Dashboard as a Space
defaults_set com.apple.dock dashboard-in-overlay bool true

# Don’t automatically rearrange Spaces based on most recent use
defaults_set com.apple.dock mru-spaces bool false

# Make Dock icons of hidden applications translucent
defaults_set com.apple.dock showhidden bool true

# Show recent applications in the Dock
defaults_set com.apple.dock show-recents bool true

# Reset Launchpad, but keep the desktop wallpaper intact
run find "${HOME}/Library/Application Support/Dock" -name "*-*.db" -maxdepth 1 -delete

###############################################################################
# Safari & WebKit                                                             #
###############################################################################

# Safari's own preferences live in a sandboxed container that `defaults` cannot
# reach on current macOS — `defaults read com.apple.Safari` returns nothing at
# all on this machine, so every write to that domain was inert. Configure
# Safari from its own settings instead.
#
# This one goes to the global domain and does apply.

# Add a context menu item for showing the Web Inspector in web views
defaults_set NSGlobalDomain WebKitDeveloperExtras bool true

###############################################################################
# Time Machine                                                                #
###############################################################################

# Prevent Time Machine from prompting to use new hard drives as backup volume
defaults_set com.apple.TimeMachine DoNotOfferNewDisksForBackup bool true

# Disable local Time Machine backups
hash tmutil &> /dev/null && run sudo tmutil disablelocal

###############################################################################
# Activity Monitor                                                            #
###############################################################################

# Show the main window when launching Activity Monitor
defaults_set com.apple.ActivityMonitor OpenMainWindow bool true

# Visualize CPU usage in the Activity Monitor Dock icon
# defaults write com.apple.ActivityMonitor IconType -int 5

# Show my processes in Activity Monitor
defaults_set com.apple.ActivityMonitor ShowCategory int 100

# Sort Activity Monitor results by CPU usage
defaults_set com.apple.ActivityMonitor SortColumn string "CPUUsage"
defaults_set com.apple.ActivityMonitor SortDirection int 0

###############################################################################
# Address Book, Dashboard, iCal, TextEdit, and Disk Utility                   #
###############################################################################

# Auto-play videos when opened with QuickTime Player
defaults_set com.apple.QuickTimePlayerX MGPlayMovieOnOpen bool true

###############################################################################
# Mac App Store                                                               #
###############################################################################

# Enable the automatic update check
defaults_set com.apple.SoftwareUpdate AutomaticCheckEnabled bool true

# Check for software updates daily, not just once per week
defaults_set com.apple.SoftwareUpdate ScheduleFrequency int 1

# Download newly available updates in background
defaults_set com.apple.SoftwareUpdate AutomaticDownload int 1

# Install System data files & security updates
defaults_set com.apple.SoftwareUpdate CriticalUpdateInstall int 1

# Automatically download apps purchased on other Macs
defaults_set com.apple.SoftwareUpdate ConfigDataInstall int 1

# Turn on app auto-update
defaults_set com.apple.commerce AutoUpdate bool true

# Allow the App Store to reboot machine on macOS updates
defaults_set com.apple.commerce AutoUpdateRestartRequired bool true

###############################################################################
# Photos                                                                      #
###############################################################################

# Prevent Photos from opening automatically when devices are plugged in
defaults_set_host com.apple.ImageCapture disableHotPlug bool true

###############################################################################
# Messages                                                                    #
###############################################################################

# Disable automatic emoji substitution (i.e. use plain text smileys)
defaults_always defaults write com.apple.messageshelper.MessageController SOInputLineSettings -dict-add "automaticEmojiSubstitutionEnablediMessage" -bool false

# Disable smart quotes as it’s annoying for messages that contain code
defaults_always defaults write com.apple.messageshelper.MessageController SOInputLineSettings -dict-add "automaticQuoteSubstitutionEnabled" -bool false

# Disable continuous spell checking
defaults_always defaults write com.apple.messageshelper.MessageController SOInputLineSettings -dict-add "continuousSpellCheckingEnabled" -bool false

###############################################################################
# Hide unused directories from ~                                              #
###############################################################################

for dir in ~/Music ~/Databases ~/.DS_Store ~/Pictures ~/Library ~/Public ~/Movies ~/Applications; do
	[ -e "$dir" ] && chflags hidden "$dir"
done

###############################################################################
# Downloads structure                                                         #
###############################################################################

run mkdir -p ~/Downloads/Documents ~/Downloads/Media/Images ~/Downloads/Media/Videos

###############################################################################
# Kill affected applications                                                  #
###############################################################################
# NOTE: "Terminal" is deliberately absent. This script is launched from
# Terminal, so killing it kills the script — that is why everything after this
# block silently failed to run on the previous install.

if [ "${DEFAULTS_CHECK:-0}" = "1" ]; then
	echo "  would run  killall on the affected apps"
else
for app in "Activity Monitor" \
	"Address Book" \
	"Calendar" \
	"cfprefsd" \
	"Contacts" \
	"Dock" \
	"Finder" \
	"Google Chrome Canary" \
	"Google Chrome" \
	"Mail" \
	"Messages" \
	"Opera" \
	"Photos" \
	"Safari" \
	"SizeUp" \
	"Spectacle" \
	"SystemUIServer" \
	"Transmission" \
	"Tweetbot" \
	"Twitter" \
	"iCal"; do
	killall "${app}" &> /dev/null
done
fi


defaults_summary

echo "Done. Note that some of these changes require a logout/restart to take effect."
